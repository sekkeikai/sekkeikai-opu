{
  "name": "sekkeikai-opu",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "setup": "node scripts/build-tokens.mjs && node scripts/copy-cms.mjs",
    "tokens": "node scripts/build-tokens.mjs",
    "cms:check": "node scripts/check-cms-config.mjs",
    "predev": "npm run setup",
    "dev": "astro dev",
    "prebuild": "npm run setup && npm run check:sources && npm run check:content",
    "build": "astro build",
    "check": "npm run setup && npm run cms:check && astro check",
    "check:sources": "node scripts/check-figure-sources.mjs",
    "check:content": "node scripts/check-content.mjs",
    "check:links": "node scripts/check-links.mjs",
    "preview": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "test": "playwright test",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@playwright/test": "^1.64.1",
    "@sveltia/cms": "0.250.1",
    "@types/node": "^24.19.2",
    "ajv": "^8.20.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.153.0",
    "yaml": "^2.9.1"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  }
}
