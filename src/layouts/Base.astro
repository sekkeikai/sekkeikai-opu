---
// 全ページ共通の枠（<head>、ヘッダー、フッター）
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const fullTitle = title === "設計会" ? "設計会 | 岡山県立大学 設計サークル" : `${title} | 設計会`;
const nav = [
  { href: "/#activities", label: "活動" },
  { href: "/projects/", label: "プロジェクト" },
  { href: "/news/", label: "お知らせ" },
  { href: "/#join", label: "入部" },
];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&family=Zen+Kaku+Gothic+New:wght@500;700;900&family=JetBrains+Mono:wght@500&display=swap"
    />
  </head>
  <body class="min-h-dvh">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:bg-paper focus:p-2"
    >
      本文へスキップ
    </a>
    <header class="sticky top-0 z-40 border-b border-grid bg-paper/85 backdrop-blur">
      <div class="container-page flex h-14 items-center justify-between gap-4">
        <a href="/" class="flex items-center gap-2 font-display text-lg font-bold tracking-widest">
          <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true">
            <rect x="1" y="1" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"></rect>
            <path d="M1 11h20M11 1v20" stroke="var(--color-proposer)" stroke-width="2"></path>
          </svg>
          設計会
        </a>
        <nav aria-label="メインメニュー">
          <ul class="flex gap-4 text-sm sm:gap-6">
            {nav.map((item) => (
              <li>
                <a href={item.href} class="hover:text-investor">
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="border-t border-grid py-10 text-sm text-muted">
      <div class="container-page flex flex-col gap-2 sm:flex-row sm:justify-between">
        <p>© 設計会（岡山県立大学）</p>
        <p>
          このサイトは部員みんなで作っています。
          <a class="underline" href="https://github.com/sekkeikai/sekkeikai-opu">
            ソースコード（GitHub）
          </a>
        </p>
      </div>
    </footer>

    <script>
      import { initMotion } from "../scripts/motion";
      initMotion();
    </script>
  </body>
</html>
