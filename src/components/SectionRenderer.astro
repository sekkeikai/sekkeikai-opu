---
// pages/*.yaml の sections を上から順に描画する。
// 新しい種類のセクションを足すときは：
//   1. src/components/sections/ にコンポーネントを作る
//   2. src/content.config.ts の section に型を足す
//   3. ここの map に登録する
//   4. public/admin/config.yml の sections.types に入力欄を足す
import type { Section } from "../content.config";
import Hero from "./sections/Hero.astro";
import Statement from "./sections/Statement.astro";
import Flow from "./sections/Flow.astro";
import Steps from "./sections/Steps.astro";
import Tags from "./sections/Tags.astro";
import Cards from "./sections/Cards.astro";
import Info from "./sections/Info.astro";
import News from "./sections/News.astro";
import Projects from "./sections/Projects.astro";
import Join from "./sections/Join.astro";

interface Props {
  sections: Section[];
}

const components = {
  hero: Hero,
  statement: Statement,
  flow: Flow,
  steps: Steps,
  tags: Tags,
  cards: Cards,
  info: Info,
  news: News,
  projects: Projects,
  join: Join,
} as const;

const { sections } = Astro.props;
---

{sections.map((section) => {
  const Component = components[section.type] as any;
  return <Component {...section} />;
})}
