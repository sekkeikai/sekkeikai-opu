---
// pages/*.yaml の sections を上から順に描画する。
// 続けて並んだ章(chapter)は一つにまとめて、目次付きの長文として表示する(sections/Chapters.astro)。
// 章には上から 01, 02… と番号を振る。まとめ(summary)には、全ての章の見出しと要点を渡す。
// 新しい種類のセクションを足すときは:
//   1. src/components/sections/ にコンポーネントをつくる
//   2. src/content.config.ts の section に型を足す
//   3. ここで描画する
//   4. public/admin/config.yml(編集画面)の sections の types に入力欄を足す(文字数の上限は zod と同じ値にする)
// 長文の中の部品(要点・問いかけ・図など)を足すときは、セクションではなくブロック(src/components/Blocks.astro)に足す。
// ブロックも同じく content.config.ts の block と、public/admin/config.yml のブロック(&blocks)の types をそろえる。
import type { Section } from "../content.config";
import Hero from "./sections/Hero.astro";
import Summary from "./sections/Summary.astro";
import Chapters from "./sections/Chapters.astro";
import Join from "./sections/Join.astro";
import Info from "./sections/Info.astro";
import News from "./sections/News.astro";

interface Props {
  sections: Section[];
}

type ChapterSection = Extract<Section, { type: "chapter" }>;
type NumberedChapter = ChapterSection & { number: string };
type Item =
  { kind: "section"; section: Exclude<Section, ChapterSection> } | { kind: "chapters"; chapters: NumberedChapter[] };

const { sections } = Astro.props;

// 章に番号を付け、続けて並んだ章をひとまとめにする
let count = 0;
const items: Item[] = [];
for (const section of sections) {
  if (section.type === "chapter") {
    const chapter = { ...section, number: String(++count).padStart(2, "0") };
    const last = items.at(-1);
    if (last?.kind === "chapters") last.chapters.push(chapter);
    else items.push({ kind: "chapters", chapters: [chapter] });
  } else {
    items.push({ kind: "section", section });
  }
}
const allChapters = items.flatMap((i) => (i.kind === "chapters" ? i.chapters : []));
---

{items.map((item) => {
  if (item.kind === "chapters") return <Chapters chapters={item.chapters} />;
  const s = item.section;
  switch (s.type) {
    case "hero":
      return <Hero {...s} />;
    case "summary":
      return <Summary {...s} chapters={allChapters} />;
    case "join":
      return <Join {...s} />;
    case "info":
      return <Info {...s} />;
    case "news":
      return <News {...s} />;
  }
})}
