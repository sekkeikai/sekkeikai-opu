---
// セクション共通の外枠。tone で明るい／濃い背景を切り替える。
interface Props {
  tone?: "light" | "dark";
  eyebrow?: string;
  title: string;
  id?: string;
}

const { tone = "light", eyebrow, title, id } = Astro.props;
const dark = tone === "dark";
---

<section
  id={id}
  class:list={["py-20 sm:py-28", dark ? "bg-blueprint-grid-dark tone-dark text-white" : "bg-paper"]}
  aria-labelledby={id ? `${id}-title` : undefined}
>
  <div class="container-page">
    {eyebrow && <p class:list={["annotation mb-3", dark ? "text-white/70" : "text-muted"]}>{eyebrow}</p>}
    <h2 id={id ? `${id}-title` : undefined} class="mb-10 text-3xl font-bold sm:text-4xl" data-reveal>
      {title}
    </h2>
    <slot />
  </div>
</section>
