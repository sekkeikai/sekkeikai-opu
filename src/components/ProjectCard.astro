---
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
  /** 見出しの階層（一覧ページの直下なら 2、セクションの中なら 3） */
  headingLevel?: 2 | 3;
}

const { project, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as "h2" | "h3";
const { title, category, stage, summary, methods, cover } = project.data;
---

<a
  href={`/projects/${project.id}/`}
  class="surface group block h-full rounded-card border border-grid bg-paper p-6 transition hover:border-ink"
>
  {cover && (
    <img
      src={cover}
      alt={project.data.coverAlt ?? ""}
      loading="lazy"
      class="mb-5 aspect-video w-full rounded-md object-cover"
    />
  )}
  <p class="annotation flex gap-3 text-muted">
    <span>{category}</span>
    <span aria-hidden="true">/</span>
    <span class="text-proposer-strong">{stage}</span>
  </p>
  <Heading class="mt-2 text-xl font-bold group-hover:text-investor">{title}</Heading>
  <p class="mt-3 text-sm">{summary}</p>
  {methods.length > 0 && (
    <ul class="mt-4 flex flex-wrap gap-2">
      {methods.map((m) => (
        <li class="rounded bg-grid px-2 py-0.5 text-xs">{m}</li>
      ))}
    </ul>
  )}
</a>
