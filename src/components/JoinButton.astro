---
// 「入部はこちら →」ボタン。押すと、入部フォーム(Microsoft Forms)が新しいタブで開く。
// ヘッダー・トップの上部・目次・入部の章で同じものを使い、文言と行き先をそろえる。
// 行き先は src/content/site/links.yaml の joinForm(編集画面の「サイトの設定」)。空の間は、押せない見た目になる。
//   size  … sm(ヘッダー・目次) / md(トップの上部) / lg(入部の章)
//   tone  … dark(明るい背景の上。黒いボタン) / light(暗い背景の上。白いボタン)
//   arrow … 「→」を付けるか。ヘッダーは幅がせまいので付けない(「入部はこちら」だけ)
import { getJoinFormUrl } from "../lib/site";

interface Props {
  size?: "sm" | "md" | "lg";
  tone?: "dark" | "light";
  arrow?: boolean;
}

const { size = "md", tone = "dark", arrow = true } = Astro.props;
const formUrl = await getJoinFormUrl();

// 角は少しだけ丸める(rounded-control = 8px)。全部のボタンを丸い錠剤の形にすると、どのサイトにもある見た目になるため
const sizeClass = {
  sm: "h-10 px-4 text-sm",
  md: "h-12 px-6",
  lg: "h-12 px-6",
}[size];
// 明るい背景の上は黒、暗い背景(入部の章)の上は白。色の付いたボタンにはしない(オレンジは印として少しだけ使う)
const toneClass = tone === "dark" ? "bg-ink text-paper" : "bg-paper text-ink";
// 押せるときだけ、指を乗せたときに少しだけ色を変える
const hoverClass = tone === "dark" ? "hover:bg-ink/85" : "hover:bg-paper/85";
---

{formUrl ? (
  <a
    href={formUrl}
    rel="noopener"
    target="_blank"
    class:list={[
      "inline-flex items-center gap-2 rounded-control font-medium whitespace-nowrap transition-colors active:scale-[0.98]",
      sizeClass,
      toneClass,
      hoverClass,
    ]}
  >
    入部はこちら
    {arrow && <span aria-hidden="true">→</span>}
    <span class="sr-only">(入部フォームが新しいタブで開きます)</span>
  </a>
) : (
  <span
    class:list={[
      "inline-flex cursor-not-allowed items-center gap-2 rounded-control font-medium whitespace-nowrap opacity-50",
      sizeClass,
      toneClass,
    ]}
    title="入部フォームは準備中です"
  >
    入部はこちら
    {arrow && <span aria-hidden="true">→</span>}
    <span class="sr-only">(入部フォームは準備中です)</span>
  </span>
)}
