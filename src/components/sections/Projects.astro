---
// プロジェクト一覧（カード）。中身は src/content/projects/ の記事。
import { getCollection } from "astro:content";
import SectionShell from "../SectionShell.astro";
import ProjectCard from "../ProjectCard.astro";

interface Props {
  tone?: "light" | "dark";
  title: string;
  body?: string;
}

const { tone, title, body } = Astro.props;
const projects = (await getCollection("projects", ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
---

<SectionShell tone={tone} title={title} eyebrow="Projects" id="projects">
  {body && (
    <p class="mb-10 max-w-3xl text-lg" data-reveal>
      {body}
    </p>
  )}
  <ul class="grid gap-6 md:grid-cols-3">
    {projects.map((project) => (
      <li data-reveal>
        <ProjectCard project={project} />
      </li>
    ))}
  </ul>
  <p class="mt-8">
    <a href="/projects/" class="underline">
      プロジェクト一覧へ
    </a>
  </p>
</SectionShell>
