---
// キーワードをタグ状に並べるセクション。
import SectionShell from "../SectionShell.astro";

interface Props {
  tone?: "light" | "dark";
  eyebrow?: string;
  title: string;
  body?: string;
  tags: string[];
}

const { tone, eyebrow, title, body, tags } = Astro.props;
---

<SectionShell tone={tone} eyebrow={eyebrow} title={title}>
  {body && (
    <p class="max-w-3xl text-lg" data-reveal>
      {body}
    </p>
  )}
  <ul class="mt-10 flex flex-wrap gap-3">
    {tags.map((tag, i) => (
      <li
        class="rounded-full border border-ink/20 px-5 py-2 text-base"
        data-reveal
        data-reveal-delay={String((i % 6) * 0.05)}
      >
        {tag}
      </li>
    ))}
  </ul>
</SectionShell>
