---
// ものづくりの工程を横一列に並べ、先頭から focusCount 個を「設計会の範囲」として囲む。
import SectionShell from "../SectionShell.astro";

interface Props {
  tone?: "light" | "dark";
  eyebrow?: string;
  title: string;
  body?: string;
  steps: string[];
  focusCount: number;
  focusLabel: string;
}

const { tone, eyebrow, title, body, steps, focusCount, focusLabel } = Astro.props;
const dark = tone === "dark";
---

<SectionShell tone={tone} eyebrow={eyebrow} title={title} id="scope">
  {body && (
    <p class:list={["max-w-3xl text-lg", dark && "text-white/85"]} data-reveal>
      {body}
    </p>
  )}
  <ol class="mt-12 flex flex-wrap items-center gap-3">
    {steps.map((step, i) => (
      <li class="flex items-center gap-3" data-reveal data-reveal-delay={String(i * 0.08)}>
        <span
          class:list={[
            "rounded-md border-2 px-4 py-2 font-bold",
            i < focusCount
              ? "border-proposer-strong bg-proposer-strong text-white"
              : dark
                ? "border-white/40 text-white/60"
                : "border-grid text-muted",
          ]}
        >
          {step}
        </span>
        {i < steps.length - 1 && (
          <span aria-hidden="true" class:list={[dark ? "text-white/50" : "text-muted"]}>
            →
          </span>
        )}
      </li>
    ))}
  </ol>
  <p class:list={["annotation mt-6", dark ? "text-proposer" : "text-proposer-strong"]} data-reveal>
    ▲ {steps.slice(0, focusCount).join("・")} ＝ {focusLabel}
  </p>
</SectionShell>
