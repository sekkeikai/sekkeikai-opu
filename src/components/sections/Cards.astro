---
// 見出し＋本文のカードを並べる汎用セクション。
import SectionShell from "../SectionShell.astro";

interface Item {
  title: string;
  body: string;
  note?: string;
}
interface Props {
  tone?: "light" | "dark";
  eyebrow?: string;
  title: string;
  items: Item[];
}

const { tone, eyebrow, title, items } = Astro.props;
const dark = tone === "dark";
---

<SectionShell tone={tone} eyebrow={eyebrow} title={title}>
  <ul class="grid gap-6 md:grid-cols-3">
    {items.map((item, i) => (
      <li
        class:list={["rounded-card p-6", dark ? "border border-white/20 bg-white/5" : "border border-grid bg-paper"]}
        data-reveal
        data-reveal-delay={String(i * 0.1)}
      >
        <h3 class="text-xl font-bold">{item.title}</h3>
        <p class:list={["mt-3", dark && "text-white/85"]}>{item.body}</p>
        {item.note && (
          <p class:list={["annotation mt-5 normal-case", dark ? "text-white/60" : "text-muted"]}>{item.note}</p>
        )}
      </li>
    ))}
  </ul>
</SectionShell>
