---
// 「単純な思いつき」と「よく考えられた設計」を左右で比べるセクション。
import SectionShell from "../SectionShell.astro";

interface Column {
  label: string;
  items: string[];
}
interface Props {
  tone?: "light" | "dark";
  eyebrow?: string;
  title: string;
  body: string;
  left: Column;
  right: Column;
}

const { tone, eyebrow, title, body, left, right } = Astro.props;
---

<SectionShell tone={tone} eyebrow={eyebrow} title={title} id="why">
  <p class="max-w-3xl text-lg" data-reveal>
    {body}
  </p>
  <div class="mt-12 grid gap-6 md:grid-cols-[1fr_auto_1fr] md:items-stretch">
    <div class="rounded-card border border-grid p-6" data-reveal>
      <p class="annotation mb-4 text-muted">{left.label}</p>
      <ul class="space-y-2 text-muted">
        {left.items.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </div>
    <div class="flex rotate-90 items-center justify-center text-3xl text-muted md:rotate-0" aria-hidden="true">
      →
    </div>
    <div class="rounded-card border-2 border-proposer bg-proposer/5 p-6" data-reveal data-reveal-delay="0.15">
      <p class="annotation mb-4 text-proposer-strong">{right.label}</p>
      <ul class="space-y-2 font-bold">
        {right.items.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </div>
  </div>
</SectionShell>
