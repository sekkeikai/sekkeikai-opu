---
// 入部の呼びかけ。身に付く力と、「入部はこちら」ボタン(入部フォームが開く)を並べる。
// ボタンの行き先は src/content/site/links.yaml の joinForm(JoinButton が読む)。
// 迷わず入部フォームへ進めるように、ボタンはこれ一つだけにする(Discord・TimeTree・メールはヘッダーとフッターにある)。
import JoinButton from "../JoinButton.astro";

interface Props {
  eyebrow?: string;
  title: string;
  body: string;
  traitsTitle?: string;
  traits: { title: string; body: string }[];
}

const { eyebrow = "入部する", title, body, traitsTitle, traits } = Astro.props;
---

<section id="join" class="scroll-mt-14 bg-ink py-20 text-paper sm:py-28" aria-labelledby="join-title">
  <div class="container-page">
    <p class="text-sm text-paper/70">{eyebrow}</p>
    <h2 id="join-title" class="mt-4 text-[2rem] leading-snug font-bold sm:text-5xl">
      {title}
    </h2>
    <p class="mt-6 max-w-[34em] font-serif text-lg leading-loose text-paper/85">{body}</p>

    {traitsTitle && traits.length > 0 && <p class="mt-14 text-sm text-paper/70">{traitsTitle}</p>}
    {traits.length > 0 && (
      <ul class:list={["grid gap-x-8 gap-y-6 sm:grid-cols-3", traitsTitle ? "mt-4" : "mt-14"]}>
        {traits.map((t) => (
          <li class="border-t border-paper/25 pt-4">
            <p class="font-display text-lg font-bold">{t.title}</p>
            <p class="mt-1 text-paper/75">{t.body}</p>
          </li>
        ))}
      </ul>
    )}

    <div class="mt-12">
      <JoinButton size="lg" tone="light" />
    </div>
  </div>
</section>
