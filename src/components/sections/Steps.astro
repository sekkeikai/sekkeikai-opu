---
// 活動の段階を縦のタイムラインで見せる。role で発案者／設計仲間／投資家の色が付く。
import SectionShell from "../SectionShell.astro";

interface Item {
  label: string;
  title: string;
  body: string;
  role?: "proposer" | "partner" | "investor" | "none";
}
interface Props {
  tone?: "light" | "dark";
  eyebrow?: string;
  title: string;
  items: Item[];
}

const { tone, eyebrow, title, items } = Astro.props;
const roleColor = {
  proposer: "bg-proposer",
  partner: "bg-partner",
  investor: "bg-investor",
  none: "bg-muted",
};
const roleName = { proposer: "発案者", partner: "設計仲間", investor: "投資家", none: "" };
---

<SectionShell tone={tone} eyebrow={eyebrow} title={title} id="activities">
  <ol class="relative grid gap-8 border-l-2 border-grid pl-8 md:grid-cols-2 md:border-l-0 md:pl-0 lg:grid-cols-3">
    {items.map((item, i) => (
      <li
        class="surface relative rounded-card border border-grid bg-paper p-6"
        data-reveal
        data-reveal-delay={String((i % 3) * 0.1)}
      >
        <span
          class:list={["absolute top-7 -left-[41px] h-4 w-4 rounded-full md:hidden", roleColor[item.role ?? "none"]]}
          aria-hidden="true"
        />
        <p class="annotation text-muted">{item.label}</p>
        <h3 class="mt-1 text-xl font-bold">{item.title}</h3>
        <p class="mt-3 text-sm">{item.body}</p>
        {item.role && item.role !== "none" && (
          <p class="mt-4 inline-flex items-center gap-2 text-xs font-bold">
            <span class:list={["h-2.5 w-2.5 rounded-full", roleColor[item.role]]} aria-hidden="true" />
            {roleName[item.role]}
          </p>
        )}
      </li>
    ))}
  </ol>
</SectionShell>
