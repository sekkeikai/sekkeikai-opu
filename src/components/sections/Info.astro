---
// 団体名・所属・代表者などを「項目: 内容」の表で見せる、ページ末尾の小さなセクション。
// 代表者は年度ごとに変わるので、ここ(コード)ではなく home.yaml から更新する。
interface Item {
  label: string;
  value: string;
}
interface Props {
  title: string;
  items: Item[];
}

const { title, items } = Astro.props;
---

<section id="about" class="scroll-mt-14 border-t border-grid bg-paper py-16" aria-labelledby="about-title">
  <div class="container-page grid gap-6 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-5">
      <h2 id="about-title" class="text-2xl font-bold">
        {title}
      </h2>
    </div>
    <dl class="divide-y divide-grid border-y border-grid lg:col-span-7">
      {items.map((item) => (
        <div class="grid gap-1 py-4 sm:grid-cols-[8rem_1fr] sm:gap-6">
          <dt class="annotation text-muted">{item.label}</dt>
          <dd class="font-bold">{item.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
