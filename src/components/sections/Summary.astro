---
// 拾い読み用のまとめ。後ろに続く章の「見出し」と「要点」を並べる(中身は home.yaml の各章から自動でつくる)。
// 多くの人はページの最初の二画面ほどしか読まないので、ここだけで話の筋が分かるようにしておく。
interface Chapter {
  id: string;
  number: string;
  eyebrow: string;
  title: string;
  point: string;
}
interface Props {
  title: string;
  lead?: string;
  chapters: Chapter[];
}

const { title, lead, chapters } = Astro.props;
---

<section
  id="summary"
  class="scroll-mt-14 border-b border-grid bg-paper-muted py-14 sm:py-20"
  aria-labelledby="summary-title"
>
  <div class="container-page">
    <h2 id="summary-title" class="text-2xl font-bold sm:text-3xl">
      {title}
    </h2>
    {lead && <p class="mt-3 max-w-2xl text-muted">{lead}</p>}
    <ol class="mt-8 grid gap-x-10 gap-y-6 md:grid-cols-2">
      {chapters.map((c) => (
        <li class="grid grid-cols-[2.25rem_1fr] gap-2">
          <span class="font-mono text-sm text-accent-strong">{c.number}</span>
          <div>
            <a href={`#${c.id}`} class="font-display text-lg leading-snug font-bold hover:text-link">
              {c.title}
            </a>
            <p class="mt-1 text-[0.95rem] leading-relaxed text-ink/75">{c.point}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
