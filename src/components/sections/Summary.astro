---
// 拾い読み用のまとめ。後ろに続く章の「見出し」と「要点」を並べる(中身は home.yaml の各章から自動でつくる)。
// 多くの人はページの最初の二画面ほどしか読まないので、ここだけで話の筋が分かるようにしておく(題は太字にして、拾い読みで目に留まるようにする)。
import BreakAtComma from "../BreakAtComma.astro";
interface Chapter {
  id: string;
  number: string;
  eyebrow: string;
  title: string;
  point: string;
}
interface Props {
  title: string;
  lead?: string;
  chapters: Chapter[];
}

const { title, lead, chapters } = Astro.props;
---

<section
  id="summary"
  class="scroll-mt-14 border-b border-grid bg-paper-muted py-14 sm:py-20"
  aria-labelledby="summary-title"
>
  <div class="container-page">
    <h2 id="summary-title" class="text-2xl font-bold">
      {title}
    </h2>
    {lead && <p class="mt-3 max-w-2xl text-muted">{lead}</p>}
    <!-- 2列の格子にすると機能紹介の型に見えるので、番号付きの1列の目次にする(上から順に読む話の筋なので) -->
    <ol class="mt-8 max-w-[46em] border-t border-grid">
      {chapters.map((c) => (
        <li class="grid grid-cols-[2.25rem_1fr] gap-2 border-b border-grid py-4">
          <span class="pt-0.5 font-mono text-sm text-muted tabular-nums">{c.number}</span>
          <div>
            <a
              href={`#${c.id}`}
              class="font-display text-lg leading-snug font-bold transition-colors [word-break:auto-phrase] hover:text-link"
            >
              <BreakAtComma text={c.title} />
            </a>
            <p class="mt-1 text-[0.95rem] leading-relaxed text-ink/80">{c.point}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
