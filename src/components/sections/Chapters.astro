---
// トップページの長文。続けて並んだ章(chapter)をまとめて表示する。
// 広い画面では左に章の目次を固定し、今読んでいる章に印を付ける(src/scripts/reading.ts)。
// 章ごとに「読者の問い(eyebrow)→ 主張の見出し → 要点 → 本文」の順に並べ、要点だけ拾い読みしても筋が通るようにする。
import type { Block } from "../../content.config";
import { numberChapters } from "../../lib/blocks";
import Blocks from "../Blocks.astro";
import JoinButton from "../JoinButton.astro";
import BreakAtComma from "../BreakAtComma.astro";

interface Chapter {
  id: string;
  number: string;
  eyebrow: string;
  title: string;
  point: string;
  blocks: Block[];
}
interface Props {
  chapters: Chapter[];
}

const numbered = numberChapters(Astro.props.chapters);
---

<div class="container-page py-16 sm:py-24 xl:grid xl:grid-cols-[12rem_minmax(0,1fr)] xl:gap-12" data-progress-target>
  <nav aria-label="章の目次" class="hidden xl:block" data-toc>
    <div class="sticky top-24">
      <p class="annotation mb-3 text-muted">目次</p>
      <ol class="space-y-1 text-sm">
        {numbered.map((c) => (
          <li>
            <a
              href={`#${c.id}`}
              class="toc-link block border-l-2 border-grid py-1.5 pl-3 text-muted [word-break:auto-phrase] hover:text-ink"
            >
              <span class="block font-mono text-[0.7rem] tabular-nums">{c.number}</span>
              {c.title}
            </a>
          </li>
        ))}
      </ol>
      <!-- 「入部はこちら」はほかの場所と同じボタンにそろえる(入部フォームが新しいタブで開く) -->
      <div class="mt-8">
        <JoinButton size="sm" />
      </div>
    </div>
  </nav>

  <div class="max-w-[57rem]">
    {numbered.map((c) => (
      <section
        id={c.id}
        class="scroll-mt-20 border-t border-grid pt-16 pb-6 first:border-t-0 first:pt-0"
        aria-labelledby={`${c.id}-title`}
        data-toc-section
      >
        <!-- 章の番号と、読者の問い(eyebrow)。番号は目次と同じ数字で、飾りの線は付けない -->
        <p class="flex items-baseline gap-3 text-sm text-muted">
          <span class="font-mono tabular-nums">{c.number}</span>
          <span>{c.eyebrow}</span>
        </p>
        <h2 id={`${c.id}-title`} class="mt-3 max-w-[18em] text-[1.75rem] leading-snug font-bold sm:text-4xl">
          <BreakAtComma text={c.title} />
        </h2>
        <div class="longform mt-6">
          <p class="point">{c.point}</p>
          <Blocks blocks={c.numbered} compactFigures />
        </div>
      </section>
    ))}
  </div>
</div>
