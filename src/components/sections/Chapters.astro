---
// トップページの長文。続けて並んだ章(chapter)をまとめて表示する。
// 広い画面では左に章の目次を固定し、今読んでいる章に印を付ける(src/scripts/reading.ts)。
// 章ごとに「読者の問い(eyebrow)→ 主張の見出し → 要点 → 本文」の順に並べ、要点だけ拾い読みしても筋が通るようにする。
import type { Block } from "../../content.config";
import { numberChapters } from "../../lib/blocks";
import Blocks from "../Blocks.astro";
import JoinButton from "../JoinButton.astro";

interface Chapter {
  id: string;
  number: string;
  eyebrow: string;
  title: string;
  point: string;
  blocks: Block[];
}
interface Props {
  chapters: Chapter[];
}

const numbered = numberChapters(Astro.props.chapters);
---

<div class="container-page py-16 sm:py-24 xl:grid xl:grid-cols-[12rem_minmax(0,1fr)] xl:gap-12" data-progress-target>
  <nav aria-label="章の目次" class="hidden xl:block" data-toc>
    <div class="sticky top-24">
      <p class="annotation mb-3 text-muted">目次</p>
      <ol class="space-y-1 text-sm">
        {numbered.map((c) => (
          <li>
            <a href={`#${c.id}`} class="toc-link block border-l-2 border-grid py-1.5 pl-3 text-muted hover:text-ink">
              <span class="block font-mono text-[0.7rem] text-accent-strong">{c.number}</span>
              {c.title}
            </a>
          </li>
        ))}
      </ol>
      <!-- 「入部はこちら」はほかの場所と同じボタンにそろえる(入部フォームが新しいタブで開く) -->
      <div class="mt-8">
        <JoinButton size="sm" />
      </div>
    </div>
  </nav>

  <div class="max-w-[57rem]">
    {numbered.map((c) => (
      <section
        id={c.id}
        class="scroll-mt-20 border-t border-grid pt-16 pb-6 first:border-t-0 first:pt-0"
        aria-labelledby={`${c.id}-title`}
        data-toc-section
      >
        <p class="flex items-center gap-3" data-reveal>
          <span class="font-mono text-sm text-accent-strong">{c.number}</span>
          <span class="h-px w-10 bg-ink/30" aria-hidden="true" />
          <span class="text-sm font-bold text-muted">{c.eyebrow}</span>
        </p>
        <h2 id={`${c.id}-title`} class="mt-4 text-[2rem] leading-tight font-black sm:text-5xl" data-reveal>
          {c.title}
        </h2>
        <div class="longform mt-8">
          <div class="my-8 max-w-[38em] rounded-r-card border-l-4 border-accent bg-accent/6 px-5 py-4" data-reveal>
            <p class="text-[1.1em] leading-relaxed font-semibold text-ink">{c.point}</p>
          </div>
          <Blocks blocks={c.numbered} compactFigures />
        </div>
      </section>
    ))}
  </div>
</div>
