---
// アクセス解析(Cloudflare Web Analytics)。<head> の中に置く。token は src/lib/analytics.ts。
// Cloudflare の管理画面が出すスニペットを、そのまま使っている(token が空なら何も出さない)。
// 記録されるのは、Web Analytics に登録したホスト名で開いたときだけ(PR のプレビューや手元で開いても、数はまざらない)。
import { analyticsToken } from "../lib/analytics";
---

{analyticsToken && (
  <script
    is:inline
    type="module"
    src="https://static.cloudflareinsights.com/beacon.min.js"
    data-cf-beacon={JSON.stringify({ token: analyticsToken })}
  />
)}
