---
// 工程のページの上に出す「今どの工程か」の帯。5 つの工程を並べ、今の工程を目立たせる。
// どの工程のページにもすぐ移れるように、全部の工程をリンクにしている。
// 工程の一覧は src/content/design/ の layer: step のページからつくる(src/lib/design.ts)。
import { getProcessSteps } from "../lib/design";

interface Props {
  // 今の工程の番号(1 から)。事例のページなどで、どれも選ばないときは省略
  current?: number;
}

const { current } = Astro.props;
const steps = await getProcessSteps();
// 前と次の工程。最初の工程の前は全体のページ、最後の工程の次は「設計を知る」の一覧(例のページへ進める)
const prev = current
  ? (steps.find((s) => s.n === current - 1) ?? { title: "設計のプロセスの全体", href: "/design/process/" })
  : undefined;
const next = current
  ? (steps.find((s) => s.n === current + 1) ?? { title: "設計の流れの例を見る", href: "/design/#cases-title" })
  : undefined;
---

<nav aria-label="設計の工程" class="mt-10">
  <ol class="grid grid-cols-5 gap-1 sm:gap-2">
    {steps.map((s) => {
      const here = s.n === current;
      return (
        <li>
          <a
            href={s.href}
            aria-current={here ? "page" : undefined}
            class:list={[
              "group block h-full rounded-md border px-2 py-2 transition sm:px-3",
              here ? "border-ink bg-ink text-paper" : "border-grid bg-paper hover:border-link",
            ]}
          >
            <span class:list={["block font-mono text-xs", here ? "text-accent" : "text-accent-strong"]}>
              {String(s.n).padStart(2, "0")}
            </span>
            <span
              class:list={[
                // スマホ幅では番号だけ見せる(名前は読み上げ用に残す)
                "sr-only mt-0.5 text-sm leading-snug font-bold sm:not-sr-only sm:block [word-break:auto-phrase]",
                !here && "group-hover:text-link",
              ]}
            >
              {s.title}
            </span>
          </a>
        </li>
      );
    })}
  </ol>
  {prev && next && (
    <div class="mt-3 flex items-start justify-between gap-4 text-sm">
      <a href={prev.href} class="underline-offset-4 hover:text-link hover:underline">
        <span aria-hidden="true">←</span> {prev.title}
      </a>
      <span class="shrink-0 text-xs text-muted sm:hidden">
        {current} / {steps.length}
      </span>
      <a href={next.href} class="text-right underline-offset-4 hover:text-link hover:underline">
        {next.title} <span aria-hidden="true">→</span>
      </a>
    </div>
  )}
</nav>
