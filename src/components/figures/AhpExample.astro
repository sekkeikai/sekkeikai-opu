---
// AHP(階層分析法)の例: サークルで 3D プリンターを選ぶときの、評価基準の重み。
// 一対比較の行列から、べき乗法で主固有ベクトル(重み)と最大固有値を求め、整合度 CI と整合比 CR(CI をランダム整合度 RI で割った値)を計算する。
import FigureFrame from "./FigureFrame.astro";

interface Props {
  number?: number;
  compact?: boolean;
}

const criteria = ["価格", "造形の精度", "扱いやすさ", "造形できる大きさ"];
// matrix[i][j]: 基準 i が基準 j に比べてどれだけ重要か(1 同じ、3 やや重要、5 重要、7 とても重要、9 極めて重要)
const matrix = [
  [1, 1 / 3, 1, 3],
  [3, 1, 3, 5],
  [1, 1 / 3, 1, 3],
  [1 / 3, 1 / 5, 1 / 3, 1],
];
const n = criteria.length;

let w = Array(n).fill(1 / n);
for (let k = 0; k < 100; k++) {
  const next = matrix.map((row) => row.reduce((s, v, j) => s + v * w[j], 0));
  const sum = next.reduce((s, v) => s + v, 0);
  w = next.map((v) => v / sum);
}
const aw = matrix.map((row) => row.reduce((s, v, j) => s + v * w[j], 0));
const lambda = aw.reduce((s, v, i) => s + v / w[i], 0) / n;
const ci = (lambda - n) / (n - 1);
const ri = 0.9; // n = 4 のときのランダム整合度(Saaty)
const cr = ci / ri;

const fmt = (v: number) => (v >= 1 ? String(Math.round(v)) : `1/${Math.round(1 / v)}`);
---

<FigureFrame
  number={Astro.props.number}
  compact={Astro.props.compact}
  title="AHPで基準の重みを求める"
  caption="左の表は「行の基準は、列の基準に比べてどれだけ重要か」をチームで話し合って決める値の例。右の重みは、この表からプログラムで計算したもの。設計案どうしも、基準ごとに同じ方法で比べて点数を付け、重みを掛けて合計する。"
  source="[T. L. Saaty, The Analytic Hierarchy Process (1980)](https://archive.org/details/analytichierarch0000saat) の方法による。例は架空"
>
  <div class="grid gap-6 lg:grid-cols-[1fr_17rem]">
    <div class="overflow-x-auto">
      <table class="w-full min-w-[26rem] border-collapse text-center text-sm">
        <caption class="sr-only">評価基準の一対比較行列</caption>
        <thead>
          <tr>
            <td></td>
            {criteria.map((c) => (
              <th scope="col" class="px-1 pb-2 text-xs font-normal text-muted">
                {c}
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {matrix.map((row, i) => (
            <tr>
              <th scope="row" class="pr-2 text-left text-xs font-normal text-muted">
                {criteria[i]}
              </th>
              {row.map((v, j) => (
                <td
                  class:list={[
                    "border border-grid py-2 font-mono",
                    i === j && "bg-paper-muted text-muted",
                    v > 1 && "font-bold text-link",
                  ]}
                >
                  {fmt(v)}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <div>
      <ul class="space-y-2">
        {criteria.map((c, i) => (
          <li>
            <div class="flex justify-between text-sm">
              <span>{c}</span>
              <span class="font-mono">{(w[i] * 100).toFixed(1)}%</span>
            </div>
            <div class="mt-1 h-2.5 rounded-full bg-paper-muted">
              <div class="h-full rounded-full bg-link" style={`width:${(w[i] * 100).toFixed(1)}%`} />
            </div>
          </li>
        ))}
      </ul>
      <!-- 整合度(CI)と整合比(CR)の数値は一行に一つずつ並べ、狭い幅でも途中で折り返さないようにする -->
      <dl class="mt-4 grid grid-cols-[auto_1fr] gap-x-3 gap-y-1 font-mono text-sm text-muted">
        <dt>λmax</dt>
        <dd>{lambda.toFixed(3)}</dd>
        <dt>CI</dt>
        <dd>{ci.toFixed(3)}</dd>
        <dt>CR</dt>
        <dd>{cr.toFixed(3)}</dd>
      </dl>
      <p class:list={["mt-2 text-sm font-bold", cr < 0.1 ? "text-positive" : "text-accent-strong"]}>
        {cr < 0.1 ? "整合している(整合比 CR < 0.1)" : "判断を見直す(整合比 CR ≥ 0.1)"}
      </p>
    </div>
  </div>
</FigureFrame>
