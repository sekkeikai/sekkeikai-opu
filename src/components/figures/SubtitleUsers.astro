---
// 字幕を使ったことがある人のうち、聴覚に障害のない人の割合を一本の帯で見せる図。
// 数字は英国 Ofcom の 2006 年の報告(約750万人のうち約600万人)。
import FigureFrame from "./FigureFrame.astro";

interface Props {
  number?: number;
  compact?: boolean;
}

const total = 750;
const hearing = 600;
const width = 600;
const split = (hearing / total) * width;
---

<FigureFrame
  number={Astro.props.number}
  compact={Astro.props.compact}
  title="一部の人のための工夫を、多くの人が使っている"
  caption="聴覚に障害のある人のためにつくられたテレビの字幕を使ったことがある人(英国、約750万人)のうち、約600万人は聴覚に障害のない人だった。"
  source="英国の放送の監督機関 Ofcom の報告 [Television access services: Review of the Code and guidance (2006)](https://web.archive.org/web/20240705100615/https://www.ofcom.org.uk/siteassets/resources/documents/consultations/uncategorised/8639-accessservs/summary/access.pdf) の 1.9 節"
  scroll
>
  <svg
    viewBox="0 0 640 120"
    class="w-full"
    role="img"
    aria-label="字幕を使ったことがある約750万人のうち、約600万人は聴覚に障害のない人、約150万人は聴覚に障害のある人。"
  >
    <text x="20" y="22" font-size="14" font-weight="700" fill="var(--color-ink)">
      テレビの字幕を使ったことがある人 約750万人
    </text>
    <rect x="20" y="36" width={split} height="40" fill="var(--color-link)" fill-opacity="0.75" />
    <rect
      x={20 + split}
      y="36"
      width={width - split}
      height="40"
      fill="var(--color-accent-strong)"
      fill-opacity="0.85"
    />
    <text x="32" y="62" font-size="14" font-weight="700" fill="var(--color-paper)">
      聴覚に障害のない人 約600万人(8割)
    </text>
    <text x={20 + width} y="104" text-anchor="end" font-size="13" fill="var(--color-ink)">
      聴覚に障害のある人 約150万人
    </text>
    <line
      x1={20 + split + (width - split) / 2}
      x2={20 + split + (width - split) / 2}
      y1="78"
      y2="90"
      stroke="var(--color-ink)"
    />
  </svg>
</FigureFrame>
