---
// 4人で10分、案を出すときの時間の使い方を、一人一本の帯で比べる図。
// 上: みんなで話しながら出す(話せるのは一度に一人。他の人は順番を待つ間に、案を忘れたり、考えが止まったりする)。
// 下: まず各自で黙って書き出す(全員が同時に案を出せる)。発言の順番は説明のための例。
import FigureFrame from "./FigureFrame.astro";

interface Props {
  number?: number;
  compact?: boolean;
}

const people = ["Aさん", "Bさん", "Cさん", "Dさん"];
const left = 90;
const perMin = 50;
const x = (m: number) => left + m * perMin;
// 話しながら出すときに、誰がいつ話しているか(分)
const turns = [
  [0, 3],
  [3, 5],
  [5, 8],
  [8, 10],
];
const order = [0, 2, 1, 3];
const ink = "var(--color-ink)";
const link = "var(--color-link)";
---

<FigureFrame
  number={Astro.props.number}
  compact={Astro.props.compact}
  title="話し合うより、まず各自で書く"
  caption="上: 話し合いながら案を出すと、話せるのは一度に一人。他の人は順番を待つ間に、案を忘れたり、考えが止まったりする。下: まず各自で黙って書き出すと、全員が同時に案を出せる。"
  source="[M. Diehl & W. Stroebe (1987)](https://doi.org/10.1037/0022-3514.53.3.497) の説明を基に作図"
  scroll
>
  <svg
    viewBox="0 0 620 330"
    class="w-full"
    role="img"
    aria-label="4人で10分案を出すときの比較。話し合いで話せるのは、一度に一人で、他の人は順番を待つ間に、案を忘れたり、考えが止まったりする。各自で書くと全員が同時に案を出せる。"
  >
    <defs>
      <pattern id="lanes-wait" width="8" height="8" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <line x1="0" y1="0" x2="0" y2="8" stroke="var(--color-muted)" stroke-opacity="0.35" stroke-width="3" />
      </pattern>
    </defs>
    {[0, 5, 10].map((m) => (
      <text x={x(m)} y="18" text-anchor="middle" font-size="12" fill="var(--color-muted)" font-family="monospace">
        {m}分
      </text>
    ))}
    {[
      { y0: 34, title: "話し合いながら出す" },
      { y0: 170, title: "まず各自で書く" },
    ].map((block, b) => (
      <g>
        <text x="12" y={block.y0 + 10} font-size="13" font-weight="700" fill={ink}>
          {block.title}
        </text>
        {people.map((p, i) => {
          const y = block.y0 + 20 + i * 26;
          const turn = turns[order.indexOf(i)];
          return (
            <g>
              <text x="40" y={y + 15} font-size="12" fill={ink}>
                {p}
              </text>
              {b === 0 ? (
                <>
                  <rect x={x(0)} y={y} width={10 * perMin} height="20" fill="url(#lanes-wait)" />
                  <rect
                    x={x(turn[0])}
                    y={y}
                    width={(turn[1] - turn[0]) * perMin}
                    height="20"
                    rx="3"
                    fill={link}
                    fill-opacity="0.6"
                  />
                </>
              ) : (
                <rect x={x(0)} y={y} width={10 * perMin} height="20" rx="3" fill={link} fill-opacity="0.6" />
              )}
            </g>
          );
        })}
      </g>
    ))}
    <rect x={x(0)} y="304" width="14" height="12" fill={link} fill-opacity="0.6" />
    <text x={x(0) + 20} y="314" font-size="12" fill={ink}>
      案を出している
    </text>
    <rect x={x(0) + 140} y="304" width="14" height="12" fill="url(#lanes-wait)" stroke="var(--color-grid)" />
    <text x={x(0) + 160} y="314" font-size="12" fill={ink}>
      順番を待っている
    </text>
  </svg>
</FigureFrame>
