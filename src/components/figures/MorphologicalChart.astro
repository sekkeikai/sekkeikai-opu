---
// 形態分析表(モルフォロジカル・チャート)の図。行は機能(要件の工程で IDEF0 に描いた3つの機能)、
// 横に並ぶマスは、その機能の解き方。各行から一つずつ選んでつないだ線が、一つの案になる。
// 例は部室の予約(架空の例)。組み合わせの数は、マスの数からこのファイルの中で計算している。
import FigureFrame from "./FigureFrame.astro";

interface Props {
  number?: number;
  compact?: boolean;
}

const ink = "var(--color-ink)";
const muted = "var(--color-muted)";
const accent = "var(--color-accent-strong)";
const link = "var(--color-link)";

// 行(機能)と、その解き方。マスの文字は2行に分けて書く
const rows = [
  {
    name: ["空き状況を", "調べる"],
    cells: [
      ["部室まで", "見に行く"],
      ["部室の前の", "紙の表"],
      ["共有", "カレンダー"],
      ["部室の前の", "ランプ"],
      ["専用", "アプリ"],
    ],
  },
  {
    name: ["予約を", "申し込む"],
    cells: [
      ["紙の表に", "書く"],
      ["係の人に", "連絡する"],
      ["カレンダー", "に書き込む"],
      ["専用アプリ", "で申し込む"],
    ],
  },
  {
    name: ["重なりを確かめ", "て確定する"],
    cells: [
      ["先に書いた", "人を優先"],
      ["係が毎日", "確かめる"],
      ["重なりを", "画面で見る"],
      ["アプリが", "自動で断る"],
    ],
  },
];

// 線でつなぐ案(各行で選んだマスの番号)。chosen は次の工程で選ばれた案
const paths = [
  { label: "無料の共有カレンダーの案(選ばれた案)", pick: [2, 2, 2], color: accent, dash: "", chosen: true },
  { label: "紙の予約表の案", pick: [1, 0, 0], color: link, dash: "6 4", chosen: false },
];

// マスの大きさと位置
const labelW = 120;
const cellW = 94;
const gap = 6;
const cellH = 50;
const rowGap = 34;
const top = 16;
const cellX = (c: number) => labelW + c * (cellW + gap);
const rowY = (r: number) => top + r * (cellH + rowGap);
const center = (r: number, c: number) => ({ x: cellX(c) + cellW / 2, y: rowY(r) + cellH / 2 });

// 組み合わせの数(各行のマスの数を掛け合わせる)
const combos = rows.reduce((n, r) => n * r.cells.length, 1);
const legendY = rowY(rows.length) + 6;
const height = legendY + paths.length * 22 + 8;
const isPicked = (r: number, c: number) => paths.find((p) => p.pick[r] === c);
---

<FigureFrame
  number={Astro.props.number}
  compact={Astro.props.compact}
  title="機能ごとの解き方を、表で組み合わせる"
  caption={`行は機能、マスはその解き方。各行から一つずつ選んでつなぐと一つの案になる。この表だけで ${combos} 通りの組み合わせがあり、筋の通るものを選んで案にする。例は部室の予約(架空の例)。`}
  source="[F. Zwicky (1967)](https://doi.org/10.1007/978-3-642-87617-2_14) の形態分析、[G. Pahl & W. Beitz 他, Engineering Design 第3版 (2007)](https://doi.org/10.1007/978-1-84628-319-2) を基に作図"
  scroll
>
  <svg
    viewBox={`0 0 640 ${height}`}
    class="w-full"
    role="img"
    aria-label={`形態分析表。${rows
      .map((r) => `${r.name.join("")}の解き方は、${r.cells.map((c) => c.join("")).join("、")}`)
      .join("。")}。${paths
      .map((p) => `${p.label}は、${p.pick.map((c, r) => rows[r].cells[c].join("")).join("、")}をつなぐ`)
      .join("。")}。`}
  >
    {rows.map((r, ri) => (
      <g>
        <!-- 行の見出し(機能) -->
        {r.name.map((line, li) => (
          <text x="4" y={rowY(ri) + 21 + li * 17} font-size="13" font-weight="700" fill={ink}>
            {line}
          </text>
        ))}
        <!-- 解き方のマス -->
        {r.cells.map((cell, ci) => {
          const p = isPicked(ri, ci);
          return (
            <g>
              <rect
                x={cellX(ci)}
                y={rowY(ri)}
                width={cellW}
                height={cellH}
                rx="4"
                fill={p?.chosen ? "var(--color-paper-muted)" : "var(--color-paper)"}
                stroke={p ? p.color : ink}
                stroke-opacity={p ? 1 : 0.3}
                stroke-width={p ? 2 : 1}
                stroke-dasharray={p ? p.dash : ""}
              />
              {cell.map((line, li) => (
                <text
                  x={cellX(ci) + cellW / 2}
                  y={rowY(ri) + 21 + li * 16}
                  text-anchor="middle"
                  font-size="12"
                  fill={ink}
                >
                  {line}
                </text>
              ))}
            </g>
          );
        })}
      </g>
    ))}

    <!-- 案: 各行で選んだマスを上から下へつなぐ線 -->
    {paths.map((p) =>
      p.pick.slice(0, -1).map((c, r) => {
        const a = center(r, c);
        const b = center(r + 1, p.pick[r + 1]);
        return (
          <line
            x1={a.x}
            y1={rowY(r) + cellH}
            x2={b.x}
            y2={rowY(r + 1)}
            stroke={p.color}
            stroke-width={p.chosen ? 3 : 2}
            stroke-dasharray={p.dash}
          />
        );
      }),
    )}

    <!-- 凡例 -->
    {paths.map((p, i) => (
      <g>
        <line
          x1={labelW}
          x2={labelW + 36}
          y1={legendY + 8 + i * 22}
          y2={legendY + 8 + i * 22}
          stroke={p.color}
          stroke-width={p.chosen ? 3 : 2}
          stroke-dasharray={p.dash}
        />
        <text x={labelW + 46} y={legendY + 12 + i * 22} font-size="12" fill={p.chosen ? ink : muted}>
          {p.label}
        </text>
      </g>
    ))}
  </svg>
</FigureFrame>
