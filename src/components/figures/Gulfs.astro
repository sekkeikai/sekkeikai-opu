---
// ノーマンの「実行の淵」と「評価の淵」。人と人工物の間にある2つの溝に、設計で橋を架ける。
import FigureFrame from "./FigureFrame.astro";

interface Props {
  number?: number;
  compact?: boolean;
}
---

<FigureFrame
  number={Astro.props.number}
  compact={Astro.props.compact}
  title="2つの淵に、橋を架ける"
  caption="人は「何をすればよいか」が分からないとき(実行の淵)と、「どうなったか」が分からないとき(評価の淵)に迷う。操作の手がかりと、すぐに返ってくる結果の表示が、それぞれの淵に架ける橋になる。"
  source="[E. L. Hutchins, J. D. Hollan, D. A. Norman (1985)](https://doi.org/10.1207/s15327051hci0104_2)、[D. A. Norman, The Design of Everyday Things (2013)](https://www.basicbooks.com/titles/don-norman/the-design-of-everyday-things/9780465050659/) を基に作図"
  scroll
>
  <svg viewBox="0 0 680 280" class="w-full" role="img" aria-label="人と人工物の間の、実行の淵と評価の淵の図">
    <defs>
      <marker id="gulf-arrow-do" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="8" markerHeight="8" orient="auto">
        <path d="M0 0 L10 5 L0 10 z" fill="var(--color-accent-strong)" />
      </marker>
      <marker id="gulf-arrow-see" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="8" markerHeight="8" orient="auto">
        <path d="M0 0 L10 5 L0 10 z" fill="var(--color-link)" />
      </marker>
    </defs>
    <rect
      x="20"
      y="70"
      width="150"
      height="140"
      rx="12"
      fill="var(--color-paper-muted)"
      stroke="var(--color-ink)"
      stroke-width="1.5"
    />
    <text x="95" y="134" text-anchor="middle" font-size="20" font-weight="700" fill="var(--color-ink)">
      人
    </text>
    <text x="95" y="158" text-anchor="middle" font-size="13" fill="var(--color-muted)">
      目標・意図
    </text>
    <rect
      x="510"
      y="70"
      width="150"
      height="140"
      rx="12"
      fill="var(--color-paper-muted)"
      stroke="var(--color-ink)"
      stroke-width="1.5"
    />
    <text x="585" y="134" text-anchor="middle" font-size="20" font-weight="700" fill="var(--color-ink)">
      人工物
    </text>
    <text x="585" y="158" text-anchor="middle" font-size="13" fill="var(--color-muted)">
      機械・画面・道具
    </text>

    <path d="M240 40 Q 225 140 240 250 L 440 250 Q 455 140 440 40 Z" fill="var(--color-ink)" fill-opacity="0.06" />
    <path
      d="M240 40 Q 225 140 240 250 M440 40 Q 455 140 440 250"
      fill="none"
      stroke="var(--color-muted)"
      stroke-dasharray="4 5"
    />

    <path
      data-draw
      d="M178 104 C 280 70, 400 70, 502 104"
      fill="none"
      stroke="var(--color-accent-strong)"
      stroke-width="3"
      marker-end="url(#gulf-arrow-do)"
    />
    <text x="340" y="58" text-anchor="middle" font-size="16" font-weight="700" fill="var(--color-accent-strong)">
      実行の淵
    </text>
    <text x="340" y="38" text-anchor="middle" font-size="12.5" fill="var(--color-muted)">
      何をすればいい?
    </text>
    <text x="340" y="112" text-anchor="middle" font-size="12.5" fill="var(--color-ink)">
      橋: 手がかり・対応付け・制約
    </text>

    <path
      data-draw
      d="M502 178 C 400 212, 280 212, 178 178"
      fill="none"
      stroke="var(--color-link)"
      stroke-width="3"
      marker-end="url(#gulf-arrow-see)"
    />
    <text x="340" y="232" text-anchor="middle" font-size="16" font-weight="700" fill="var(--color-link)">
      評価の淵
    </text>
    <text x="340" y="254" text-anchor="middle" font-size="12.5" fill="var(--color-muted)">
      どうなった?
    </text>
    <text x="340" y="176" text-anchor="middle" font-size="12.5" fill="var(--color-ink)">
      橋: フィードバック・状態の表示
    </text>
  </svg>
</FigureFrame>
