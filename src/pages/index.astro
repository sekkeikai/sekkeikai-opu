---
// トップページ。中身は src/content/pages/home.yaml(CMS の「ページ > トップページ」で編集できる)
import { getEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import SectionRenderer from "../components/SectionRenderer.astro";

const home = await getEntry("pages", "home");
if (!home) throw new Error("src/content/pages/home.yaml が見つかりません");
---

<Base title={home.data.title} description={home.data.description} progress>
  <SectionRenderer sections={home.data.sections} />
</Base>
