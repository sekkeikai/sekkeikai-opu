---
// 「設計を知る」の入口(/design/)。階層が分かるように、次の順に並べる:
//   流れ(プロセスの全体 → 5 つの工程)→ 視点 → 工程 × 視点の地図 → 例(事例のページ。理論を読み終えたあとに置く)→ その他のテーマ
// どの一覧も src/content/design/ のページ(YAML)からつくるので、ページを足せば自動で増える。
// 地図(工程 × 視点の表)は、工程のページと各視点の perStep からつくる(src/components/DesignMatrix.astro)。
import Base from "../../layouts/Base.astro";
import DesignMatrix from "../../components/DesignMatrix.astro";
import { getDesignPages, getProcessSteps } from "../../lib/design";

const [process] = await getDesignPages("process");
const steps = await getProcessSteps();
const cases = await getDesignPages("case");
const lenses = await getDesignPages("lens");
const topics = await getDesignPages("topic");
---

<Base
  title="設計を知る"
  description="設計のプロセス(工程)と、どの工程にも通じる視点(モデル化・ヒューマンインターフェース・データ分析など)の解説。"
>
  <!-- 方眼の背景はトップの最初の画面だけに使う(どのページの頭にも敷くと、ただの飾りになるため) -->
  <header class="border-b border-grid">
    <div class="container-page py-16 sm:py-20">
      <h1 class="text-4xl font-bold sm:text-5xl">設計を知る</h1>
      <p class="mt-6 max-w-[34em] font-serif text-lg leading-loose text-ink/80">
        設計は、5つの工程を行き来しながら進みます。どの工程でも、「モデルで考える」「人から考える」「データで考える」のような視点を使います。
      </p>
    </div>
  </header>

  <!-- 同じ大きさの箱を並べると型どおりの見た目になるので、「設計のプロセス」だけを枠で囲み、ほかは細い線で区切った一覧にする。
       一覧の行は行全体がリンク。題の後ろの「→」で、押せることを示す -->
  <div class="container-page space-y-20 py-16 sm:py-20">
    {process && (
      <section aria-labelledby="process-title">
        <a
          href={`/design/${process.id}/`}
          class="group block rounded-card border border-ink/80 bg-paper p-6 transition-colors hover:bg-paper-muted sm:p-10"
        >
          <h2 id="process-title" class="text-2xl font-bold group-hover:text-link sm:text-3xl">
            {process.data.title}
          </h2>
          <p class="mt-4 max-w-2xl">{process.data.summary}</p>
          <p class="mt-6 font-medium text-link">
            全体を読む <span aria-hidden="true">→</span>
          </p>
        </a>
        <ol class="mt-8 grid border-t border-ink/80 sm:grid-cols-2 lg:grid-cols-5">
          {steps.map((s) => (
            <li class="border-b border-grid lg:border-b-0">
              <a href={s.href} class="group block h-full py-4 pr-4">
                <p class="annotation text-muted">
                  工程 {s.n} / {s.sub}
                </p>
                <p class="mt-1 font-display text-lg font-bold group-hover:text-link">
                  {s.title}{" "}
                  <span class="text-base font-normal text-muted group-hover:text-link" aria-hidden="true">
                    →
                  </span>
                </p>
                <p class="mt-1 text-sm text-ink/80">「{s.question}」</p>
              </a>
            </li>
          ))}
        </ol>
      </section>
    )}

    {lenses.length > 0 && (
      <section aria-labelledby="lenses-title">
        <h2 id="lenses-title" class="text-2xl font-bold sm:text-3xl">
          どの工程にも通じる視点
        </h2>
        <ul class="mt-6 border-t border-ink/80">
          {lenses.map((l) => (
            <li class="border-b border-grid">
              <a href={`/design/${l.id}/`} class="group grid gap-1 py-5 sm:grid-cols-[14rem_minmax(0,1fr)] sm:gap-8">
                <span>
                  <span class="block font-display text-xl font-bold group-hover:text-link">
                    {l.data.short}{" "}
                    <span class="text-base font-normal text-muted group-hover:text-link" aria-hidden="true">
                      →
                    </span>
                  </span>
                  <span class="block text-sm text-muted">{l.data.title}</span>
                </span>
                <span class="text-sm leading-relaxed text-ink/80">{l.data.summary}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section aria-labelledby="matrix-title">
      <h2 id="matrix-title" class="mb-8 text-2xl font-bold sm:text-3xl">
        工程 × 視点の地図
      </h2>
      <DesignMatrix />
    </section>

    {/* 例は、工程・視点・地図を読み終えたあとに置く(理論の途中に例を挟まない) */}
    {cases.length > 0 && (
      <section aria-labelledby="cases-title">
        <h2 id="cases-title" class="text-2xl font-bold sm:text-3xl">
          設計の流れの例
        </h2>
        <p class="mt-3 max-w-2xl text-ink/80">
          設計会で一つのテーマに取り組むなら、どんな手順で進めるか。目的を決めるところから、仕様書や手順書ができるまでを示した計画の例です。
        </p>
        <ul class="mt-6 border-t border-ink/80">
          {cases.map((c) => (
            <li class="border-b border-grid">
              <a href={`/design/${c.id}/`} class="group grid gap-1 py-5 sm:grid-cols-[14rem_minmax(0,1fr)] sm:gap-8">
                <span>
                  <span class="block font-display text-xl font-bold group-hover:text-link">
                    {c.data.title}{" "}
                    <span class="text-base font-normal text-muted group-hover:text-link" aria-hidden="true">
                      →
                    </span>
                  </span>
                  <span class="block text-sm text-muted">{c.data.short}</span>
                </span>
                <span class="text-sm leading-relaxed text-ink/80">{c.data.summary}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {topics.length > 0 && (
      <section aria-labelledby="topics-title">
        <h2 id="topics-title" class="text-2xl font-bold sm:text-3xl">
          その他のテーマ
        </h2>
        <ul class="mt-6 border-t border-ink/80">
          {topics.map((t) => (
            <li class="border-b border-grid">
              <a href={`/design/${t.id}/`} class="group grid gap-1 py-5 sm:grid-cols-[14rem_minmax(0,1fr)] sm:gap-8">
                <span class="block font-display text-xl font-bold group-hover:text-link">
                  {t.data.title}{" "}
                  <span class="text-base font-normal text-muted group-hover:text-link" aria-hidden="true">
                    →
                  </span>
                </span>
                <span class="text-sm leading-relaxed text-ink/80">{t.data.summary}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</Base>
