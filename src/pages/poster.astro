---
// ポスターの QR コードの行き先(/poster/)。中身はトップページと同じ。
// URL を分けておくと、アクセス解析で「ポスターから来た人」を /poster/ として数えられる
// (Web Analytics は ?from=… のような URL の後ろの部分を数えないため、ページの場所を分けている)。
// 検索結果に同じページが2つ出ないように、検索エンジンには出さず、本来のページはトップ(/)だと伝える。
// QR は刷ったら直せないので、この URL は消さない。行き先を変えたいときは、このファイルの中身を変える。
import { getEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import SectionRenderer from "../components/SectionRenderer.astro";

const home = await getEntry("pages", "home");
if (!home) throw new Error("src/content/pages/home.yaml が見つかりません");
---

<Base title={home.data.title} description={home.data.description} progress noindex canonical="/">
  <SectionRenderer sections={home.data.sections} />
</Base>
