---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import ProjectCard from "../../components/ProjectCard.astro";

const projects = (await getCollection("projects", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base title="プロジェクト" description="設計会で取り組んでいる設計プロジェクトの一覧です。">
  <section class="container-page py-20">
    <p class="annotation mb-3 text-muted">Projects</p>
    <h1 class="mb-12 text-4xl font-bold">プロジェクト</h1>
    <ul class="grid gap-6 md:grid-cols-3">
      {projects.map((project) => (
        <li>
          <ProjectCard project={project} headingLevel={2} />
        </li>
      ))}
    </ul>
  </section>
</Base>
